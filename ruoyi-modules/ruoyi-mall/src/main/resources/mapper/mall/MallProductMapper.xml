<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.mapper.MallProductMapper">

    <resultMap type="MallProduct" id="MallProductResult">
        <id     property="productId"   column="product_id"   />
        <result property="sku"         column="sku"          />
        <result property="productName" column="product_name" />
        <result property="category"    column="category"     />
        <result property="price"       column="price"        />
        <result property="stock"       column="stock"        />
        <result property="status"      column="status"       />
        <result property="remark"      column="remark"       />
        <result property="createTime"  column="create_time"  />
        <result property="updateTime"  column="update_time"  />
        <result property="delFlag"     column="del_flag"     />
    </resultMap>

    <sql id="selectProductVo">
        select product_id, sku, product_name, category, price, stock, status, remark, create_time, update_time, del_flag
        from mall_product
    </sql>

    <select id="selectProductById" parameterType="Long" resultMap="MallProductResult">
        <include refid="selectProductVo"/>
        where product_id = #{productId} and del_flag = '0'
    </select>

    <select id="selectProductBySku" parameterType="String" resultMap="MallProductResult">
        <include refid="selectProductVo"/>
        where sku = #{sku} and del_flag = '0'
    </select>

    <select id="selectProductList" parameterType="MallProduct" resultMap="MallProductResult">
        <include refid="selectProductVo"/>
        <where>
            del_flag = '0'
            <if test="sku != null and sku != ''">
                AND sku like concat('%', #{sku}, '%')
            </if>
            <if test="productName != null and productName != ''">
                AND product_name like concat('%', #{productName}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                AND create_time &gt;= #{params.beginTime}
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                AND create_time &lt;= #{params.endTime}
            </if>
        </where>
        order by product_id desc
    </select>

    <insert id="insertProduct" parameterType="MallProduct" useGeneratedKeys="true" keyProperty="productId">
        insert into mall_product (
            sku, product_name, category, price, stock, status, remark, create_time, update_time, del_flag
        ) values (
            #{sku}, #{productName}, #{category}, #{price}, #{stock}, #{status}, #{remark}, now(), now(), '0'
        )
    </insert>

    <update id="updateProduct" parameterType="MallProduct">
        update mall_product
        <set>
            <if test="sku != null">sku = #{sku},</if>
            <if test="productName != null">product_name = #{productName},</if>
            <if test="category != null">category = #{category},</if>
            <if test="price != null">price = #{price},</if>
            <if test="stock != null">stock = #{stock},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = now()
        </set>
        where product_id = #{productId} and del_flag = '0'
    </update>

    <update id="deleteProductByIds" parameterType="Long">
        update mall_product
        set del_flag = '2', update_time = now()
        where product_id in
        <foreach collection="array" item="productId" open="(" separator="," close=")">
            #{productId}
        </foreach>
    </update>

    <update id="reduceStock">
        update mall_product
        set stock = stock - #{quantity}
        where product_id = #{productId} and del_flag = '0' and stock &gt;= #{quantity}
    </update>

</mapper>
