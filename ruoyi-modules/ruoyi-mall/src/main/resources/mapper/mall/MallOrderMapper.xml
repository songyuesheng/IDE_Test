<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.mapper.MallOrderMapper">
    
    <resultMap type="MallOrder" id="MallOrderResult">
        <result property="orderId"    column="order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="buyerName"    column="buyer_name"    />
        <result property="buyerPhone"    column="buyer_phone"    />
        <result property="address"    column="address"    />
        <result property="status"    column="status"    />
        <result property="totalAmount"    column="total_amount"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <resultMap id="MallOrderMallOrderItemResult" type="MallOrder" extends="MallOrderResult">
        <collection property="mallOrderItemList" notNullColumn="sub_item_id" javaType="java.util.List" resultMap="MallOrderItemResult" />
    </resultMap>

    <resultMap type="MallOrderItem" id="MallOrderItemResult">
        <result property="itemId"    column="sub_item_id"    />
        <result property="orderId"    column="sub_order_id"    />
        <result property="productId"    column="sub_product_id"    />
        <result property="sku"    column="sub_sku"    />
        <result property="productName"    column="sub_product_name"    />
        <result property="unitPrice"    column="sub_unit_price"    />
        <result property="quantity"    column="sub_quantity"    />
        <result property="lineAmount"    column="sub_line_amount"    />
    </resultMap>

    <sql id="selectMallOrderVo">
        select order_id, order_no, buyer_name, buyer_phone, address, status, total_amount, remark, create_time, update_time from mall_order
    </sql>

    <select id="selectMallOrderList" parameterType="MallOrder" resultMap="MallOrderResult">
        <include refid="selectMallOrderVo"/>
        <where>  
            <if test="orderNo != null  and orderNo != ''"> and order_no = #{orderNo}</if>
            <if test="buyerName != null  and buyerName != ''"> and buyer_name like concat('%', #{buyerName}, '%')</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="params.beginTime != null and params.beginTime != ''"><!-- 开始时间检索 -->
                and date_format(create_time,'%y%m%d') &gt;= date_format(#{params.beginTime},'%y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''"><!-- 结束时间检索 -->
                and date_format(create_time,'%y%m%d') &lt;= date_format(#{params.endTime},'%y%m%d')
            </if>
        </where>
    </select>
    
    <select id="selectMallOrderByOrderId" parameterType="Long" resultMap="MallOrderMallOrderItemResult">
        select a.order_id, a.order_no, a.buyer_name, a.buyer_phone, a.address, a.status, a.total_amount, a.remark, a.create_time, a.update_time,
 b.item_id as sub_item_id, b.order_id as sub_order_id, b.product_id as sub_product_id, b.sku as sub_sku, b.product_name as sub_product_name, b.unit_price as sub_unit_price, b.quantity as sub_quantity, b.line_amount as sub_line_amount
        from mall_order a
        left join mall_order_item b on b.order_id = a.order_id
        where a.order_id = #{orderId}
    </select>
        
    <insert id="insertMallOrder" parameterType="MallOrder" useGeneratedKeys="true" keyProperty="orderId">
        insert into mall_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">order_no,</if>
            <if test="buyerName != null and buyerName != ''">buyer_name,</if>
            <if test="buyerPhone != null">buyer_phone,</if>
            <if test="address != null">address,</if>
            <if test="status != null">status,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="remark != null">remark,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">#{orderNo},</if>
            <if test="buyerName != null and buyerName != ''">#{buyerName},</if>
            <if test="buyerPhone != null">#{buyerPhone},</if>
            <if test="address != null">#{address},</if>
            <if test="status != null">#{status},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateMallOrder" parameterType="MallOrder">
        update mall_order
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">order_no = #{orderNo},</if>
            <if test="buyerName != null and buyerName != ''">buyer_name = #{buyerName},</if>
            <if test="buyerPhone != null">buyer_phone = #{buyerPhone},</if>
            <if test="address != null">address = #{address},</if>
            <if test="status != null">status = #{status},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where order_id = #{orderId}
    </update>

    <delete id="deleteMallOrderByOrderId" parameterType="Long">
        delete from mall_order where order_id = #{orderId}
    </delete>

    <delete id="deleteMallOrderByOrderIds" parameterType="String">
        delete from mall_order where order_id in 
        <foreach item="orderId" collection="array" open="(" separator="," close=")">
            #{orderId}
        </foreach>
    </delete>
    
</mapper>
