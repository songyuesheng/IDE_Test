<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.mapper.MallOrderMapper">

    <resultMap type="MallOrder" id="MallOrderResult">
        <id     property="orderId"     column="order_id"     />
        <result property="orderNo"     column="order_no"     />
        <result property="buyerName"   column="buyer_name"   />
        <result property="buyerPhone"  column="buyer_phone"  />
        <result property="address"     column="address"      />
        <result property="status"      column="status"       />
        <result property="totalAmount" column="total_amount" />
        <result property="remark"      column="remark"       />
        <result property="createTime"  column="create_time"  />
        <result property="updateTime"  column="update_time"  />
    </resultMap>

    <sql id="selectOrderVo">
        select order_id, order_no, buyer_name, buyer_phone, address, status, total_amount, remark, create_time, update_time
        from mall_order
    </sql>

    <select id="selectOrderById" parameterType="Long" resultMap="MallOrderResult">
        <include refid="selectOrderVo"/>
        where order_id = #{orderId}
    </select>

    <select id="selectOrderByOrderNo" parameterType="String" resultMap="MallOrderResult">
        <include refid="selectOrderVo"/>
        where order_no = #{orderNo}
    </select>

    <select id="selectOrderList" parameterType="MallOrder" resultMap="MallOrderResult">
        <include refid="selectOrderVo"/>
        <where>
            <if test="orderNo != null and orderNo != ''">
                AND order_no like concat('%', #{orderNo}, '%')
            </if>
            <if test="buyerName != null and buyerName != ''">
                AND buyer_name like concat('%', #{buyerName}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                AND create_time &gt;= #{params.beginTime}
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                AND create_time &lt;= #{params.endTime}
            </if>
        </where>
        order by order_id desc
    </select>

    <insert id="insertOrder" parameterType="MallOrder" useGeneratedKeys="true" keyProperty="orderId">
        insert into mall_order (
            order_no, buyer_name, buyer_phone, address, status, total_amount, remark, create_time, update_time
        ) values (
            #{orderNo}, #{buyerName}, #{buyerPhone}, #{address}, #{status}, #{totalAmount}, #{remark}, now(), now()
        )
    </insert>

    <update id="updateOrder" parameterType="MallOrder">
        update mall_order
        <set>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="buyerName != null">buyer_name = #{buyerName},</if>
            <if test="buyerPhone != null">buyer_phone = #{buyerPhone},</if>
            <if test="address != null">address = #{address},</if>
            <if test="status != null">status = #{status},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = now()
        </set>
        where order_id = #{orderId}
    </update>

    <delete id="deleteOrderById" parameterType="Long">
        delete from mall_order where order_id = #{orderId}
    </delete>

    <delete id="deleteOrderByIds" parameterType="Long">
        delete from mall_order where order_id in
        <foreach collection="array" item="orderId" open="(" separator="," close=")">
            #{orderId}
        </foreach>
    </delete>

</mapper>
