<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.mapper.MallOrderItemMapper">

    <resultMap type="MallOrderItem" id="MallOrderItemResult">
        <id     property="itemId"        column="item_id"        />
        <result property="orderId"       column="order_id"       />
        <result property="productId"     column="product_id"     />
        <result property="sku"            column="sku"            />
        <result property="productName"   column="product_name"   />
        <result property="unitPrice"     column="unit_price"     />
        <result property="quantity"      column="quantity"       />
        <result property="lineAmount"    column="line_amount"    />
    </resultMap>

    <sql id="selectMallOrderItemVo">
        select item_id, order_id, product_id, sku, product_name, unit_price, quantity, line_amount
        from mall_order_item
    </sql>

    <select id="selectMallOrderItemsByOrderId" parameterType="Long" resultMap="MallOrderItemResult">
        <include refid="selectMallOrderItemVo"/>
        where order_id = #{orderId}
    </select>

    <insert id="insertMallOrderItem" parameterType="MallOrderItem" useGeneratedKeys="true" keyProperty="itemId">
        insert into mall_order_item (
            <if test="orderId != null">order_id,</if>
            <if test="productId != null">product_id,</if>
            <if test="sku != null and sku != ''">sku,</if>
            <if test="productName != null and productName != ''">product_name,</if>
            <if test="unitPrice != null">unit_price,</if>
            <if test="quantity != null">quantity,</if>
            <if test="lineAmount != null">line_amount,</if>
            create_time
        )values(
            <if test="orderId != null">#{orderId},</if>
            <if test="productId != null">#{productId},</if>
            <if test="sku != null and sku != ''">#{sku},</if>
            <if test="productName != null and productName != ''">#{productName},</if>
            <if test="unitPrice != null">#{unitPrice},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="lineAmount != null">#{lineAmount},</if>
            sysdate()
        )
    </insert>

    <insert id="insertMallOrderItemBatch" parameterType="java.util.List">
        insert into mall_order_item (order_id, product_id, sku, product_name, unit_price, quantity, line_amount, create_time)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.orderId}, #{item.productId}, #{item.sku}, #{item.productName}, #{item.unitPrice}, #{item.quantity}, #{item.lineAmount}, sysdate())
        </foreach>
    </insert>

    <update id="updateMallOrderItem" parameterType="MallOrderItem">
        update mall_order_item
        <set>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="sku != null and sku != ''">sku = #{sku},</if>
            <if test="productName != null and productName != ''">product_name = #{productName},</if>
            <if test="unitPrice != null">unit_price = #{unitPrice},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="lineAmount != null">line_amount = #{lineAmount},</if>
        </set>
        where item_id = #{itemId}
    </update>

    <delete id="deleteMallOrderItemByOrderId" parameterType="Long">
        delete from mall_order_item where order_id = #{orderId}
    </delete>

    <delete id="deleteMallOrderItemById" parameterType="Long">
        delete from mall_order_item where item_id = #{itemId}
    </delete>

</mapper>
