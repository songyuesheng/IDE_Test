<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mall.mapper.MallOrderItemMapper">

    <resultMap type="MallOrderItem" id="MallOrderItemResult">
        <id     property="itemId"      column="item_id"      />
        <result property="orderId"     column="order_id"     />
        <result property="productId"   column="product_id"   />
        <result property="sku"         column="sku"          />
        <result property="productName" column="product_name" />
        <result property="unitPrice"   column="unit_price"   />
        <result property="quantity"    column="quantity"     />
        <result property="lineAmount"  column="line_amount"  />
    </resultMap>

    <sql id="selectOrderItemVo">
        select item_id, order_id, product_id, sku, product_name, unit_price, quantity, line_amount
        from mall_order_item
    </sql>

    <select id="selectItemsByOrderId" parameterType="Long" resultMap="MallOrderItemResult">
        <include refid="selectOrderItemVo"/>
        where order_id = #{orderId}
        order by item_id asc
    </select>

    <insert id="insertOrderItems" parameterType="java.util.List">
        insert into mall_order_item (
            order_id, product_id, sku, product_name, unit_price, quantity, line_amount
        ) values
        <foreach collection="list" item="item" separator=",">
            (
            #{item.orderId}, #{item.productId}, #{item.sku}, #{item.productName}, #{item.unitPrice}, #{item.quantity}, #{item.lineAmount}
            )
        </foreach>
    </insert>

    <delete id="deleteItemsByOrderId" parameterType="Long">
        delete from mall_order_item where order_id = #{orderId}
    </delete>

</mapper>
